// =========================================================================
// ВЫЧИСЛИТЕЛЬНЫЙ ДВИЖОК
// =========================================================================
#let n = data.len()
#let sum_x = data.sum()
#let mean_x = sum_x / n

#let V = data.map(x => x - mean_x)
#let sum_V = V.sum()

#let V2 = V.map(v => calc.pow(v, 2))
#let sum_V2 = V2.sum()

#let sigma_x = calc.sqrt(sum_V2 / (n - 1))
#let three_sigma = 3 * sigma_x
#let max_V_abs = calc.max(..V.map(calc.abs))
#let sigma_mean = sigma_x / calc.sqrt(n)

// Коэффициент Стьюдента для P=0.95 при n-1=9 (интерполяция)
#let t_8 = 2.306
#let t_10 = 2.228
#let t = (t_8 + t_10) / 2
#let delta = t * sigma_mean

// =========================================================================
// ФУНКЦИЯ АВТОМАТИЧЕСКОГО МЕТРОЛОГИЧЕСКОГО ОКРУГЛЕНИЯ (МИ 1317-86)
// =========================================================================
#let metro-round(mean-val, delta-val) = {
  let m = calc.floor(calc.log(delta-val, base: 10))
  let pow_m = calc.pow(10.0, m)
  let first_digit = calc.floor(delta-val / pow_m)

  // Если 1 или 2 -> 2 значащие цифры, иначе 1
  let sig_figs = if first_digit <= 2 { 2 } else { 1 }
  let p = m - (sig_figs - 1)
  let dec = if p < 0 { -p } else { 0 }
  let factor = calc.pow(10.0, dec)

  // Округление погрешности строго в большую сторону
  let delta_rounded = calc.ceil((delta-val * factor) - 1e-9) / factor
  let mean_rounded = calc.round(mean-val, digits: dec)

  let fmt-num(val, d) = {
    let s = str(calc.round(val, digits: d))
    if d > 0 {
      if not s.contains(".") {
        s = s + "." + ("0" * d)
      } else {
        let parts = s.split(".")
        let frac = parts.at(1)
        if frac.len() < d {
          frac = frac + ("0" * (d - frac.len()))
        }
        s = parts.at(0) + "." + frac
      }
    }
    s
  }

  (
    delta: fmt-num(delta_rounded, dec),
    mean: fmt-num(mean_rounded, dec),
    dec: dec,
    d1: first_digit,
    sig: sig_figs
  )
}

#let mr = metro-round(mean_x, delta)

